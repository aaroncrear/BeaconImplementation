<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Duration_Weeks__c</fullName>
    <description>Auto-calculated number of weeks between Kickoff and Deadline. Blank until both dates are set.</description>
    <externalId>false</externalId>
    <formula>(Deadline__c - Kickoff__c) / 7</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <inlineHelpText>Calculated from Kickoff and Deadline.</inlineHelpText>
    <label>Duration (Weeks)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>1</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
