<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Deadline_After_Kickoff</fullName>
    <active>true</active>
    <description>Deadline cannot be before Kickoff.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Kickoff__c)), NOT(ISBLANK(Deadline__c)), Deadline__c &lt; Kickoff__c)</errorConditionFormula>
    <errorDisplayField>Deadline__c</errorDisplayField>
    <errorMessage>Deadline cannot be before Kickoff.</errorMessage>
</ValidationRule>
