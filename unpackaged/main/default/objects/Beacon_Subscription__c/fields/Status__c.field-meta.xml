<?xml version="1.0" encoding="utf-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status__c</fullName>
    <description>Displays a green Active flag (Active static resource) when the Active checkbox is true, otherwise a red Inactive flag (Inactive static resource).</description>
    <externalId>false</externalId>
    <formula>IF( Active__c,
    IMAGE("/resource/Active", "Active", 20, 60),
    IMAGE("/resource/Inactive", "Inactive", 20, 69)
)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
