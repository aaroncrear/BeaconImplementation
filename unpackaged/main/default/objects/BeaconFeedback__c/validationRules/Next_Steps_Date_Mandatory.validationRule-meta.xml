<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Next_Steps_Date_Mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
				RecordType.DeveloperName = "Sales_Demo",
				ISCHANGED(Survey_Completed__c),  
				TEXT(Survey_Completed__c) = "YES",  
				ISBLANK(Next_Steps_Date__c)
				
)</errorConditionFormula>
    <errorDisplayField>Next_Steps_Date__c</errorDisplayField>
    <errorMessage>Please fill in the Next Steps Date field when completing the survey</errorMessage>
</ValidationRule>
