<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Data_Comprehensiveness</fullName>
    <active>true</active>
    <description>Makes sure Data Comprehensiveness is a number between 1 and 5. Honors the On/Off Switch (Run Validation Rules).</description>
    <errorConditionFormula>$Setup.On_Off_Switch__c.Run_Validation_Rules__c &amp;&amp; (
    OR(
    					Data_Comprehensiveness__c &gt; 5,
    					Data_Comprehensiveness__c &lt; 1
    	)
)</errorConditionFormula>
    <errorDisplayField>Data_Comprehensiveness__c</errorDisplayField>
    <errorMessage>Select a number between 1 and 5</errorMessage>
</ValidationRule>
