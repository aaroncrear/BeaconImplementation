        <displayFormat>MCP-{00000}</displayFormat>
        <label>Module Count Price Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Beacon Module Count Prices</pluralLabel>
    <searchLayouts/>
