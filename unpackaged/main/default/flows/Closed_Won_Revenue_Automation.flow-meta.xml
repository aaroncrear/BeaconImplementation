    <assignments>
        <description>Sets the error message when the Opportunity has no Accepted Quote.</description>
        <name>Set_No_Quote_Error</name>
        <label>Set No Quote Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
