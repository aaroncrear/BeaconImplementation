<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Native Revenue Cloud Create Contract action (the same action used by the Create Contract From Quote screen flow). Creates the Contract from the Accepted Quote and saves the quote&apos;s net unit prices as contract prices.</description>
        <name>Create_Contract</name>
        <label>Create Contract</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>createContract</actionName>
        <actionType>createContract</actionType>
        <connector>
            <targetReference>Assign_New_Contract</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Handle_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>sourceId</name>
            <value>
                <elementReference>Get_Accepted_Quote.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>contractPriceOption</name>
            <value>
                <stringValue>NET_UNIT_PRICE_ONLY</stringValue>
            </value>
        </inputParameters>
        <nameSegment>createContract</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <description>Native Revenue Cloud Create Orders From Quote action (the same action used by Quote - Create Order - Screen Flow). With only the Quote Id, it creates a single Order from all of the quote lines.</description>
