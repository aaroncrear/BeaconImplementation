                <elementReference>Get_Accepted_Quote.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>createOrdersFromQuote</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <versionString>1.0.0</versionString>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
