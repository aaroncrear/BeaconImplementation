    <recordUpdates>
        <description>Activates the Contract (Status = Activated) unless it is already active.</description>
        <name>Activate_Contract</name>
        <label>Activate Contract</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Existing_Order</targetReference>
