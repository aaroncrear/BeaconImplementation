            <operator>Assign</operator>
            <value>
                <elementReference>Get_Accepted_Quote.ContractId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Activate_Contract</targetReference>
        </connector>
    </assignments>
