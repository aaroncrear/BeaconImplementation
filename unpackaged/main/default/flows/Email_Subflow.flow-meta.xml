    <description>This Subflow sends email. It is called from various record-triggered Flows across multiple Objects. This allows a single place to identify and update email actions.</description>
    <environments>Default</environments>
    <formulas>
        <description>Creates a clickable link</description>
        <name>formRecordLink</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_630}, FIND( &apos;/services&apos;, {!$Api.Partner_Server_URL_630}))+{!varRecordID}</expression>
    </formulas>
    <interviewLabel>Email Subflow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Email Subflow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Finds the active Campaign on the Parent Campaign record type whose Primary Module matches the Primary Module of the Case&apos;s Opportunity and that has a ResOps Primary. If more than one matches, the oldest Campaign is used, the same as in Opportunity - On Update - After Save.</description>
        <name>Get_Campaign</name>
        <label>Get Campaign</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Campaign_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Path_Subflow</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Parent_Campaign_Record_Type.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Primary_Module__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case.Opportunity__r.Primary_Module__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ResOps_Primary__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Campaign</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>ResOps_Primary__c</queriedFields>
        <queriedFields>ResOps_Secondary__c</queriedFields>
        <queriedFields>ResOps_Manager__c</queriedFields>
        <queriedFields>Primary_Module__c</queriedFields>
        <queriedFields>RecordTypeId</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets the Case record that triggered this Subflow</description>
        <name>Get_Case</name>
        <label>Get Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Which_Case_Trigger</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Path_Subflow</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varRecordID</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the Campaign Parent Campaign record type by its developer name (Parent_Campaign), so its Id isn&apos;t hardcoded.</description>
        <name>Get_Parent_Campaign_Record_Type</name>
        <label>Get Parent Campaign Record Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Can_Look_Up_Campaign</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Path_Subflow</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Campaign</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Parent_Campaign</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Which_Object</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <description>Used to send email notification</description>
        <name>Fault_Path_Subflow</name>
        <label>Fault Path Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Fault_Path_Subflow</flowName>
        <inputAssignments>
            <name>varFaultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <textTemplates>
        <description>Body of the ResOps Case Created email. &quot;Case {Case Number}&quot; links to the Case.</description>
        <name>ttResOpsCaseCreatedBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;ResOps &lt;a href=&quot;{!formRecordLink}&quot;&gt;Case {!Get_Case.CaseNumber}&lt;/a&gt; has been created. Please review.&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <description>Subject of the ResOps Case Created email.</description>
        <name>ttResOpsCaseCreatedSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>ResOps Case {!Get_Case.CaseNumber} - {!Get_Case.Type}</text>
    </textTemplates>
    <variables>
        <description>Collection of email addresses for recipients of ResOps Case notifications</description>
        <name>collResOpsCaseRecipients</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>The Object that triggered this Subflow</description>
        <name>varObject</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>The record ID that triggered this Subflow</description>
        <name>varRecordID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>The specific trigger for this Subflow</description>
        <name>varTrigger</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
