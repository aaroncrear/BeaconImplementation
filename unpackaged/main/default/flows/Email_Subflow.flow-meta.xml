<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Emails the ResOps Manager, ResOps Primary and ResOps Secondary from the Case&apos;s Parent Campaign that a ResOps Case was created, with a link to the Case. Sent from the Beacon Salesforce Automations org-wide email address.</description>
        <name>Send_ResOps_Case_Created_Email</name>
        <label>Send ResOps Case Created Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <faultConnector>
            <targetReference>Fault_Path_Subflow</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddressesArray</name>
            <value>
                <elementReference>collResOpsCaseRecipients</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <stringValue>OrgWideEmailAddress</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderAddress</name>
            <value>
                <stringValue>digital.salesforce@beaconintel.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>ttResOpsCaseCreatedSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>ttResOpsCaseCreatedBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Adds the email addresses of the Campaign&apos;s ResOps Manager, ResOps Primary and ResOps Secondary to the list of ResOps Case notification recipients.</description>
        <name>Add_ResOps_Recipient_Emails</name>
        <label>Add ResOps Recipient Emails</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>collResOpsCaseRecipients</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_Campaign.ResOps_Manager__r.Email</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>collResOpsCaseRecipients</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_Campaign.ResOps_Primary__r.Email</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>collResOpsCaseRecipients</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_Campaign.ResOps_Secondary__r.Email</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_ResOps_Case_Created_Email</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Checks that a Parent Campaign with a matching Primary Module and a ResOps Primary was found. If not, no email is sent.</description>
        <name>Campaign_Found</name>
        <label>Campaign Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Campaign Not Found</defaultConnectorLabel>
        <rules>
            <name>Matching_Campaign_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Campaign</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_ResOps_Recipient_Emails</targetReference>
            </connector>
            <label>Matching Campaign Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks that the Case was found, its Opportunity has a Primary Module, and the Campaign Parent Campaign record type was found before looking up the Campaign. Without all three, the lookup could match the wrong Campaign, so no email is sent.</description>
        <name>Can_Look_Up_Campaign</name>
        <label>Can Look Up Campaign?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Missing Case, Primary Module or Record Type</defaultConnectorLabel>
        <rules>
            <name>Case_Primary_Module_And_Record_Type_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.Opportunity__r.Primary_Module__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Parent_Campaign_Record_Type</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Campaign</targetReference>
            </connector>
            <label>Case, Primary Module and Record Type Found</label>
        </rules>
    </decisions>
    <decisions>
