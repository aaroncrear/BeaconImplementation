<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Sets the compliance fields on the current Contact in the loop to match the triggering Account, then adds it to the Contacts to Update collection for a single bulk update.</description>
        <name>Assign_Contact_Values</name>
        <label>Assign Contact Values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Contacts.Blacklisted__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Record.Blacklisted__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Contacts.Blacklisted_Reason__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Record.Blacklisted_Reason__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Contacts.DoNotCall</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Record.Do_Not_Call__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Contacts.HasOptedOutOfEmail</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Record.Email_Opt_Out__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Contacts_to_Update</assignToReference>
            <operator>Add</operator>
            <value><elementReference>Loop_Contacts</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Loop_Contacts</targetReference></connector>
    </assignments>
    <assignments>
        <description>Sets the compliance fields on the current Lead in the loop to match the triggering Account, then adds it to the Leads to Update collection for a single bulk update.</description>
        <name>Assign_Lead_Values</name>
        <label>Assign Lead Values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Leads.Blacklisted__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Record.Blacklisted__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Leads.Blacklisted_Reason__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Record.Blacklisted_Reason__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Leads.DoNotCall</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Record.Do_Not_Call__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Leads.HasOptedOutOfEmail</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Record.Email_Opt_Out__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Leads_to_Update</assignToReference>
            <operator>Add</operator>
            <value><elementReference>Loop_Leads</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Loop_Leads</targetReference></connector>
    </assignments>
    <assignments>
        <description>Sets the compliance fields on the current open Opportunity in the loop to match the triggering Account, then adds it to the Opportunities to Update collection for a single bulk update.</description>
        <name>Assign_Opportunity_Values</name>
        <label>Assign Opportunity Values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Opportunities.Blacklisted__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Record.Blacklisted__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Opportunities.Blacklisted_Reason__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Record.Blacklisted_Reason__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Opportunities.Do_Not_Call__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Record.Do_Not_Call__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Opportunities.Email_Opt_Out__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Record.Email_Opt_Out__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Opportunities_to_Update</assignToReference>
            <operator>Add</operator>
            <value><elementReference>Loop_Opportunities</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Loop_Opportunities</targetReference></connector>
    </assignments>
    <description>When any of the compliance fields (Blacklisted, Blacklisted Reason, Do Not Call, Email Opt Out) is changed on an Account, this after-save flow copies the new values to the corresponding fields on all related Contacts, all related Leads (Account lookup), and all open Opportunities. Each database operation routes its fault path to the reusable Fault Path Subflow, which emails an automation-failure notification.</description>
    <environments>Default</environments>
    <interviewLabel>Account - On Update - After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - On Update - After Save</label>
    <loops>
        <description>Iterates over the related Contacts so each one's compliance fields can be set to match the Account.</description>
        <name>Loop_Contacts</name>
        <label>Loop Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Contacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector><targetReference>Assign_Contact_Values</targetReference></nextValueConnector>
        <noMoreValuesConnector><targetReference>Update_Contacts</targetReference></noMoreValuesConnector>
    </loops>
    <loops>
        <description>Iterates over the related Leads so each one's compliance fields can be set to match the Account.</description>
        <name>Loop_Leads</name>
        <label>Loop Leads</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Leads</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector><targetReference>Assign_Lead_Values</targetReference></nextValueConnector>
        <noMoreValuesConnector><targetReference>Update_Leads</targetReference></noMoreValuesConnector>
    </loops>
    <loops>
        <description>Iterates over the related open Opportunities so each one's compliance fields can be set to match the Account.</description>
        <name>Loop_Opportunities</name>
        <label>Loop Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Open_Opportunities</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector><targetReference>Assign_Opportunity_Values</targetReference></nextValueConnector>
        <noMoreValuesConnector><targetReference>Update_Opportunities</targetReference></noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Retrieves all Contacts related to the triggering Account so their compliance fields can be synced.</description>
        <name>Get_Contacts</name>
        <label>Get Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Loop_Contacts</targetReference></connector>
        <faultConnector><targetReference>Fault_Path_Subflow</targetReference></faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Id</elementReference></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves all Leads whose Account lookup points to the triggering Account so their compliance fields can be synced.</description>
        <name>Get_Leads</name>
        <label>Get Leads</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Loop_Leads</targetReference></connector>
        <faultConnector><isGoTo>true</isGoTo><targetReference>Fault_Path_Subflow</targetReference></faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Id</elementReference></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves all open Opportunities related to the triggering Account so their compliance fields can be synced.</description>
        <name>Get_Open_Opportunities</name>
        <label>Get Open Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Loop_Opportunities</targetReference></connector>
        <faultConnector><isGoTo>true</isGoTo><targetReference>Fault_Path_Subflow</targetReference></faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Id</elementReference></value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Bulk-updates all related Contacts with the synced compliance field values.</description>
        <name>Update_Contacts</name>
        <label>Update Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Get_Leads</targetReference></connector>
        <faultConnector><isGoTo>true</isGoTo><targetReference>Fault_Path_Subflow</targetReference></faultConnector>
        <inputReference>Contacts_to_Update</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Bulk-updates all related Leads with the synced compliance field values.</description>
        <name>Update_Leads</name>
        <label>Update Leads</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Get_Open_Opportunities</targetReference></connector>
        <faultConnector><isGoTo>true</isGoTo><targetReference>Fault_Path_Subflow</targetReference></faultConnector>
        <inputReference>Leads_to_Update</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Bulk-updates all related open Opportunities with the synced compliance field values.</description>
        <name>Update_Opportunities</name>
        <label>Update Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector><isGoTo>true</isGoTo><targetReference>Fault_Path_Subflow</targetReference></faultConnector>
        <inputReference>Opportunities_to_Update</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Get_Contacts</targetReference></connector>
        <filterFormula>OR(ISCHANGED({!$Record.Blacklisted__c}), ISCHANGED({!$Record.Blacklisted_Reason__c}), ISCHANGED({!$Record.Do_Not_Call__c}), ISCHANGED({!$Record.Email_Opt_Out__c}))</filterFormula>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>On any fault, calls the reusable Fault Path Subflow to email an automation-failure notification with the fault message.</description>
        <name>Fault_Path_Subflow</name>
        <label>Fault Path Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Fault_Path_Subflow</flowName>
        <inputAssignments>
            <name>varFaultMessage</name>
            <value><elementReference>$Flow.FaultMessage</elementReference></value>
        </inputAssignments>
    </subflows>
    <variables>
        <description>Collection of related Contacts to bulk-update with the synced compliance field values.</description>
        <name>Contacts_to_Update</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <description>Collection of related Leads to bulk-update with the synced compliance field values.</description>
        <name>Leads_to_Update</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
    <variables>
        <description>Collection of related open Opportunities to bulk-update with the synced compliance field values.</description>
        <name>Opportunities_to_Update</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Opportunity</objectType>
    </variables>
</Flow>
