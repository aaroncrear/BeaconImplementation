<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Sets the Case Owner to the ResOps Primary user on the matching Parent Campaign.</description>
        <name>Assign_Case_Owner</name>
        <label>Assign Case Owner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Parent_Campaign.ResOps_Primary__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Checks that the Case&apos;s Opportunity has a Primary Module and the Campaign Parent Campaign record type was found before looking up the Parent Campaign. Without both, the lookup could match the wrong Campaign, so the Owner is left as it is.</description>
        <name>Can_Look_Up_Parent_Campaign</name>
        <label>Can Look Up Parent Campaign?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Missing Primary Module or Record Type</defaultConnectorLabel>
        <rules>
            <name>Primary_Module_And_Record_Type_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Primary_Module__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Parent_Campaign_Record_Type</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Parent_Campaign</targetReference>
            </connector>
            <label>Primary Module and Record Type Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks that a Parent Campaign with a matching Primary Module and a ResOps Primary was found. If not, the Owner is left as it is.</description>
        <name>Parent_Campaign_Found</name>
        <label>Parent Campaign Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Parent Campaign Not Found</defaultConnectorLabel>
        <rules>
            <name>Campaign_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Parent_Campaign</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Case_Owner</targetReference>
            </connector>
            <label>Campaign Found</label>
        </rules>
    </decisions>
    <description>When a ResOps Request Case is created, sets its Owner to the ResOps Primary on the active Parent Campaign whose Primary Module matches the Primary Module of the Case&apos;s Opportunity. Uses the same Campaign matching as Opportunity - On Update - After Save. If no such Campaign is found, the Owner is left as it is. Only runs when Run Flows is checked on the On/Off Switch custom setting.</description>
    <environments>Default</environments>
    <interviewLabel>Case - On Create - Before Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case - On Create - Before Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Finds the active Campaign on the Parent Campaign record type (Sub Campaigns and Campaigns on other record types are never matched) whose Primary Module matches the Primary Module of the Case&apos;s Opportunity and that has a ResOps Primary. If more than one matches, the oldest Campaign is used.</description>
        <name>Get_Parent_Campaign</name>
        <label>Get Parent Campaign</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Parent_Campaign_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Parent_Campaign_Record_Type.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Primary_Module__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Opportunity__r.Primary_Module__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ResOps_Primary__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Campaign</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>ResOps_Primary__c</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the active Campaign Parent Campaign record type by its developer name (Parent_Campaign), so its Id isn&apos;t hardcoded.</description>
        <name>Get_Parent_Campaign_Record_Type</name>
        <label>Get Parent Campaign Record Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Can_Look_Up_Parent_Campaign</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Campaign</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Parent_Campaign</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Parent_Campaign_Record_Type</targetReference>
        </connector>
        <filterFormula>AND(
    {!$Setup.On_Off_Switch__c.Run_Flows__c},
    {!$Record.RecordType.DeveloperName} = &quot;ResOps_Request&quot;
)</filterFormula>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
