<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Sets the Opportunity owner to the Account Manager.</description>
        <name>Assign_Owner_to_AM</name>
        <label>Assign Owner to AM</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Active_AM.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Only runs for users in an SDR role.</description>
        <name>Created_by_SDR</name>
        <label>Created by SDR?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not SDR</defaultConnectorLabel>
        <rules>
            <name>SDR_Created</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.On_Off_Switch__c.Run_Flows__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formCreatedBySDR</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_Team_AM</targetReference>
            </connector>
            <label>SDR Created</label>
        </rules>
    </decisions>
    <decisions>
        <description>Leaves the SDR as owner when the Account has no active Account Manager.</description>
        <name>AM_Found</name>
        <label>AM Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Active AM</defaultConnectorLabel>
        <rules>
            <name>Active_AM_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Active_AM.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Owner_to_AM</targetReference>
            </connector>
            <label>Active AM Found</label>
        </rules>
    </decisions>
    <description>When an SDR creates an Opportunity (directly or by converting a Lead) on an Account with an active Account Manager on its Account Team, makes that Account Manager the Opportunity owner. The SDR is added to the Opportunity Team by Opportunity - On Create - After Save. Skipped when the On/Off Switch Run Flows is unchecked.</description>
    <environments>Default</environments>
    <formulas>
        <description>True when the running user is in an SDR role (role API name starting with SDR_).</description>
        <name>formCreatedBySDR</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!$UserRole.DeveloperName}, &quot;SDR_&quot;)</expression>
    </formulas>
    <interviewLabel>Opportunity - On Create - Before Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - On Create - Before Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Gets the oldest Account Team member on the Account with the Account Manager role.</description>
        <name>Get_Account_Team_AM</name>
        <label>Get Account Team AM</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Active_AM</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>TeamMemberRole</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Account Manager</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AccountTeamMember</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>UserId</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Checks the Account Manager is an active user.</description>
        <name>Get_Active_AM</name>
        <label>Get Active AM</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>AM_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Account_Team_AM.UserId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Created_by_SDR</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
