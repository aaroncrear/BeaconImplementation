<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Checks whether an Opportunity was created during the Lead conversion, since users can choose not to create one. The Opportunity is only updated when one exists.</description>
        <name>Opportunity_Created</name>
        <label>Opportunity Created?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Opportunity Created</defaultConnectorLabel>
        <rules>
            <name>Opportunity_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ConvertedOpportunityId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Converted_Opportunity</targetReference>
            </connector>
            <label>Opportunity Exists</label>
        </rules>
    </decisions>
    <description>When a Lead is converted, stamps the resulting Account, Contact, and Opportunity (if one was created) with Created Through Lead Conversion = true and Converted Lead ID = the 18-digit Id of the converted Lead. The Account and Contact are only stamped when they were newly created by the conversion, not when the Lead was converted into an existing Account or Contact.</description>
    <environments>Default</environments>
    <formulas>
        <description>Returns 60 seconds before this flow interview started. Accounts and Contacts created by the conversion are inserted in the same transaction just before this flow runs, so a CreatedDate on or after this time means the record was created by the conversion rather than being an existing record the Lead was converted into.</description>
        <name>formConversionWindowStart</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.InterviewStartTime} - (60 / 86400)</expression>
    </formulas>
    <interviewLabel>Lead - On Conversion - After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead - On Conversion - After Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Sets Created Through Lead Conversion to true and Converted Lead ID to the converted Lead&apos;s Id on the Account the Lead was converted into, only if that Account was newly created by the conversion (CreatedDate on or after formConversionWindowStart). An existing Account chosen during conversion matches no records and is left unchanged.</description>
        <name>Update_Converted_Account</name>
        <label>Update Converted Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Converted_Contact</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Path_Subflow</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ConvertedAccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>formConversionWindowStart</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Converted_Lead_ID__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Created_Through_Lead_Conversion__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <recordUpdates>
        <description>Sets Created Through Lead Conversion to true and Converted Lead ID to the converted Lead&apos;s Id on the Contact the Lead was converted into, only if that Contact was newly created by the conversion (CreatedDate on or after formConversionWindowStart). An existing Contact chosen during conversion matches no records and is left unchanged.</description>
        <name>Update_Converted_Contact</name>
        <label>Update Converted Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Opportunity_Created</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Fault_Path_Subflow</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ConvertedContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>formConversionWindowStart</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Converted_Lead_ID__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Created_Through_Lead_Conversion__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Contact</object>
    </recordUpdates>
    <recordUpdates>
        <description>Sets Created Through Lead Conversion to true and Converted Lead ID to the converted Lead&apos;s Id on the Opportunity created during the conversion.</description>
        <name>Update_Converted_Opportunity</name>
        <label>Update Converted Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Fault_Path_Subflow</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ConvertedOpportunityId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Converted_Lead_ID__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Created_Through_Lead_Conversion__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Converted_Account</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>Sends an email notification with the fault message if any of the Account, Contact, or Opportunity updates fail.</description>
        <name>Fault_Path_Subflow</name>
        <label>Fault Path Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Fault_Path_Subflow</flowName>
        <inputAssignments>
            <name>varFaultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
