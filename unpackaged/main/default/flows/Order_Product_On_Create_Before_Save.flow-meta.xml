<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Copies Number of Users from the quote line. Because this flow runs before the record is saved, assigning directly to $Record saves the value with no extra DML operation.</description>
        <name>Set_Number_of_Users</name>
        <label>Set Number of Users</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Number_of_Users__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Quote_Line.Number_of_Users__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Checks whether the quote line was found and has Number of Users, so the value is only set when there is one to copy.</description>
        <name>Quote_Line_Has_Users</name>
        <label>Quote Line Has Users?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Users</defaultConnectorLabel>
        <rules>
            <name>Has_Users</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Line.Number_of_Users__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Number_of_Users</targetReference>
            </connector>
            <label>Has Users</label>
        </rules>
    </decisions>
    <description>When an Order Product is created from a quote line (Create Orders From Quote), copies Number of Users from the quote line. Number of Users then carries on to the Asset (Create Asset Order Event - Mark Order Assets Created). Only runs when the Order Product has a Quote Line Item, Number of Users is blank, and Run Flows is checked on the On/Off Switch custom setting.</description>
    <environments>Default</environments>
    <interviewLabel>Order Product - On Create - Before Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order Product - On Create - Before Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Gets the quote line this Order Product was created from.</description>
        <name>Get_Quote_Line</name>
        <label>Get Quote Line</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Quote_Line_Has_Users</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.QuoteLineItemId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>QuoteLineItem</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Number_of_Users__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Quote_Line</targetReference>
        </connector>
        <filterFormula>AND(
    {!$Setup.On_Off_Switch__c.Run_Flows__c},
    NOT(ISBLANK({!$Record.QuoteLineItemId})),
    ISBLANK({!$Record.Number_of_Users__c})
)</filterFormula>
        <object>OrderItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
