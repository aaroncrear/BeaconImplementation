<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Checks whether the Task&apos;s Name (WhoId) is a Lead (Id starts with 00Q) or a Contact (Id starts with 003).</description>
        <name>Related_To_Lead_Or_Contact</name>
        <label>Related To Lead Or Contact?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Lead Or Contact</defaultConnectorLabel>
        <rules>
            <name>Related_To_Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.WhoId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>00Q</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Status_To_Working</targetReference>
            </connector>
            <label>Related To Lead</label>
        </rules>
        <rules>
            <name>Related_To_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.WhoId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>003</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contact_Status_To_Working</targetReference>
            </connector>
            <label>Related To Contact</label>
        </rules>
    </decisions>
    <description>When a Task is updated to a Status of Completed, the Lead Status or Contact Status of the related Lead or Contact (Name) is set to Working, but only when its current status is New. Tasks with a Task Subtype of Task, or with no Task Subtype, are skipped. Only runs when Run Flows is checked on the On/Off Switch custom setting.</description>
    <environments>Default</environments>
    <interviewLabel>Task - On Update - After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Task - On Update - After Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Sets the related Contact&apos;s Contact Status to Working. The Contact Status = New filter means the Contact is only updated when its current status is New.</description>
        <name>Update_Contact_Status_To_Working</name>
        <label>Update Contact Status To Working</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Fault_Path_Subflow</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhoId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Contact_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>New</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Contact_Status__c</field>
            <value>
                <stringValue>Working</stringValue>
            </value>
        </inputAssignments>
        <object>Contact</object>
    </recordUpdates>
    <recordUpdates>
        <description>Sets the related Lead&apos;s Status to Working. The Status = New filter means the Lead is only updated when its current Status is New. Converted Leads are skipped.</description>
        <name>Update_Lead_Status_To_Working</name>
        <label>Update Lead Status To Working</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Fault_Path_Subflow</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhoId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>New</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Working</stringValue>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Related_To_Lead_Or_Contact</targetReference>
        </connector>
        <filterFormula>AND(
    {!$Setup.On_Off_Switch__c.Run_Flows__c},
    ISPICKVAL({!$Record.Status}, &quot;Completed&quot;),
    NOT(ISBLANK(TEXT({!$Record.TaskSubtype}))),
    NOT(ISPICKVAL({!$Record.TaskSubtype}, &quot;Task&quot;)),
    NOT(ISBLANK({!$Record.WhoId})),
    ISCHANGED({!$Record.Status})
)</filterFormula>
        <object>Task</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>Used to send email notification</description>
        <name>Fault_Path_Subflow</name>
        <label>Fault Path Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Fault_Path_Subflow</flowName>
        <inputAssignments>
            <name>varFaultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
