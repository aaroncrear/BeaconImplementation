<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Adds the quote line Id to the list used to find the lines&apos; Number of Users attribute values.</description>
        <name>Add_Line_Id</name>
        <label>Add Line Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varLineIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Lines.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Lines</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Sets the line&apos;s Number of Users to the attribute value and adds it to the list of lines to update.</description>
        <name>Add_Line_To_Update</name>
        <label>Add Line To Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varLine.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Match_Lines.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varLine.Number_of_Users__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formAttributeUsers</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varLinesToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varLine</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Match_Lines</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Checks whether the Number of Users attribute exists in this org. If not, there is nothing to copy.</description>
        <name>Attribute_Definition_Found</name>
        <label>Attribute Definition Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Users_Attribute_Definition.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Quote_Lines</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks whether the quote has lines.</description>
        <name>Lines_Found</name>
        <label>Lines Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Lines</defaultConnectorLabel>
        <rules>
            <name>Has_Lines</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Lines</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Lines</targetReference>
            </connector>
            <label>Has Lines</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks whether this is the line the attribute value belongs to, and whether its Number of Users is different from the attribute value. Only changed lines are updated, so a second run finds nothing to change and stops.</description>
        <name>Line_Needs_Update</name>
        <label>Line Needs Update?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Match_Lines</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Needs_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Match_Lines.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Loop_Attributes.QuoteLineItemId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formAttributeUsers</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formUsersDifferent</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Line_To_Update</targetReference>
            </connector>
            <label>Needs Update</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks whether any lines need their Number of Users updated.</description>
        <name>Lines_To_Update_Found</name>
        <label>Lines To Update?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Has_Lines_To_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varLinesToUpdate</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Line_Users</targetReference>
            </connector>
            <label>Has Lines To Update</label>
        </rules>
    </decisions>
    <description>When Revenue Cloud finishes pricing a Draft quote, copies each line&apos;s Number of Users product attribute (entered in Browse Catalogs, where it is required) into the quote line&apos;s Number of Users field, which is used for reporting, the Lines Missing Users check, and the Opportunity Product, Order Product, Asset and renewal steps. Quote Line Item Attribute can&apos;t trigger a flow, and a rep changing only the attribute doesn&apos;t always save the line again, but every add, remove or reconfigure reprices the quote, which changes Calculation Status. Runs on the Run Asynchronously path, after the save has finished, so the attribute records exist. Only updates lines whose value is different. Updating a quote line directly doesn&apos;t reprice the quote (tested in HTCDEV on 5 Nov 2026) and doesn&apos;t change Calculation Status, so this flow can&apos;t trigger itself. Only runs while the Quote is Draft, and when Run Flows is checked on the On/Off Switch custom setting.</description>
    <environments>Default</environments>
    <formulas>
        <description>The Number of Users attribute value as a number. Blank when the attribute has no value.</description>
        <name>formAttributeUsers</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK( {!Loop_Attributes.AttributeValue} ), NULL, VALUE( {!Loop_Attributes.AttributeValue} ) )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>True when the line&apos;s Number of Users field is blank or different from the attribute value.</description>
        <name>formUsersDifferent</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    ISBLANK( {!Loop_Match_Lines.Number_of_Users__c} ),
    {!Loop_Match_Lines.Number_of_Users__c} &lt;&gt; {!formAttributeUsers}
)</expression>
    </formulas>
    <interviewLabel>Quote - Pricing Complete - Sync Number of Users {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote - Pricing Complete - Sync Number of Users</label>
    <loops>
        <description>Collects the quote line Ids.</description>
        <name>Loop_Lines</name>
        <label>Loop Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Quote_Lines</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Line_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_User_Attributes</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>For each Number of Users attribute value, finds its quote line.</description>
        <name>Loop_Attributes</name>
        <label>Loop Attributes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_User_Attributes</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Loop_Match_Lines</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Lines_To_Update_Found</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Finds the quote line for the current attribute value.</description>
        <name>Loop_Match_Lines</name>
        <label>Loop Match Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Quote_Lines</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Line_Needs_Update</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Loop_Attributes</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Gets the Number of Users attribute definition by its API name, so the flow works in every org without a hard-coded Id.</description>
        <name>Get_Users_Attribute_Definition</name>
        <label>Get Users Attribute Definition</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Attribute_Definition_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Path_Subflow</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Number_of_Users</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AttributeDefinition</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets the quote&apos;s lines and their current Number of Users.</description>
        <name>Get_Quote_Lines</name>
        <label>Get Quote Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Lines_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Path_Subflow</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>QuoteLineItem</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Number_of_Users__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets the Number of Users attribute values for the quote&apos;s lines, in one query.</description>
        <name>Get_User_Attributes</name>
        <label>Get User Attributes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Attributes</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Path_Subflow</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteLineItemId</field>
            <operator>In</operator>
            <value>
                <elementReference>varLineIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>AttributeDefinitionId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Users_Attribute_Definition.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>QuoteLineItemAttribute</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>QuoteLineItemId</queriedFields>
        <queriedFields>AttributeValue</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Saves Number of Users on the changed lines. Quote Line Item - On Create or Update - After Save then copies it to the matching Opportunity Products.</description>
        <name>Update_Line_Users</name>
        <label>Update Line Users</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Fault_Path_Subflow</targetReference>
        </faultConnector>
        <inputReference>varLinesToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>false</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND(
    {!$Setup.On_Off_Switch__c.Run_Flows__c},
    ISCHANGED({!$Record.CalculationStatus}),
    OR(
        ISPICKVAL({!$Record.CalculationStatus}, &quot;CompletedWithPricing&quot;),
        ISPICKVAL({!$Record.CalculationStatus}, &quot;CompletedWithTax&quot;)
    ),
    ISPICKVAL({!$Record.Status}, &quot;Draft&quot;)
)</filterFormula>
        <object>Quote</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Get_Users_Attribute_Definition</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>Used to send email notification</description>
        <name>Fault_Path_Subflow</name>
        <label>Fault Path Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Fault_Path_Subflow</flowName>
        <inputAssignments>
            <name>varFaultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <description>Quote line record used to build each Number of Users update.</description>
        <name>varLine</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>QuoteLineItem</objectType>
    </variables>
    <variables>
        <description>Ids of the quote&apos;s lines.</description>
        <name>varLineIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Quote lines whose Number of Users needs updating.</description>
        <name>varLinesToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>QuoteLineItem</objectType>
    </variables>
</Flow>
