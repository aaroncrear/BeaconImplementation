<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Copies Number of Users from the Asset being renewed or amended. Because this flow runs before the record is saved, assigning directly to $Record saves the value with no extra DML operation.</description>
        <name>Set_Number_of_Users</name>
        <label>Set Number of Users</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Number_of_Users__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Source_Asset.Number_of_Users__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Checks whether the quote line has a Source Asset, so the Asset is only looked up for renewal and amendment lines.</description>
        <name>Has_Source_Asset</name>
        <label>Has Source Asset?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Source Asset</defaultConnectorLabel>
        <rules>
            <name>Source_Asset_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Action.SourceAssetId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Source_Asset</targetReference>
            </connector>
            <label>Source Asset Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks whether the Asset has Number of Users, so the value is only set when there is one to copy.</description>
        <name>Asset_Has_Users</name>
        <label>Asset Has Users?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Users</defaultConnectorLabel>
        <rules>
            <name>Has_Users</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Source_Asset.Number_of_Users__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Number_of_Users</targetReference>
            </connector>
            <label>Has Users</label>
        </rules>
    </decisions>
    <description>When a quote line is created for an existing Asset (for example by Create Renewal Quote in Order - Assets Created - Create Renewal, or an amendment), copies Number of Users from that Asset, so the renewal is priced at the customer&apos;s current users. The Asset is found through the line&apos;s Quote Action (Source Asset). Only runs when the line has a Quote Action, Number of Users is blank, and Run Flows is checked on the On/Off Switch custom setting.</description>
    <environments>Default</environments>
    <interviewLabel>Quote Line Item - On Create - Before Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote Line Item - On Create - Before Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Gets the line&apos;s Quote Action, which holds the Source Asset for renewal and amendment lines.</description>
        <name>Get_Quote_Action</name>
        <label>Get Quote Action</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Source_Asset</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.QuoteActionId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>QuoteAction</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>SourceAssetId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets the Asset being renewed or amended.</description>
        <name>Get_Source_Asset</name>
        <label>Get Source Asset</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Asset_Has_Users</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Quote_Action.SourceAssetId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Asset</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Number_of_Users__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Quote_Action</targetReference>
        </connector>
        <filterFormula>AND(
    {!$Setup.On_Off_Switch__c.Run_Flows__c},
    NOT(ISBLANK({!$Record.QuoteActionId})),
    ISBLANK({!$Record.Number_of_Users__c})
)</filterFormula>
        <object>QuoteLineItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
