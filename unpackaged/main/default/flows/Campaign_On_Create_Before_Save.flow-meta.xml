<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Sets the Sub Campaign&apos;s Type field to the Type field value from its Parent Campaign. Because this flow runs before the record is saved, assigning directly to $Record saves the value with no extra DML operation.</description>
        <name>Update_Sub_Campaign_Primary_Module</name>
        <label>Update Sub Campaign Primary Module</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Primary_Module__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Parent_Campaign.Primary_Module__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Checks whether the Get Parent Campaign lookup found a Parent Campaign record, so the Type update is skipped if the Sub Campaign has no ParentId set.</description>
        <name>Parent_Campaign_Found</name>
        <label>Parent Campaign Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Parent Found</defaultConnectorLabel>
        <rules>
            <name>Parent_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Parent_Campaign.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Sub_Campaign_Primary_Module</targetReference>
            </connector>
            <label>Parent Found</label>
        </rules>
    </decisions>
    <description>When a Sub Campaign is created, sets its Primary Module field to match the Primary Module field on its Parent Campaign.</description>
    <environments>Default</environments>
    <interviewLabel>Campaign - On Create - Before Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Campaign - On Create - Before Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Retrieves the Parent Campaign referenced by this Sub Campaign&apos;s ParentId, so its Type field can be copied onto the Sub Campaign.</description>
        <name>Get_Parent_Campaign</name>
        <label>Get Parent Campaign</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Parent_Campaign_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Campaign</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Parent_Campaign</targetReference>
        </connector>
        <filterFormula>{!$Record.RecordType.DeveloperName} = &quot;Sub_Campaign&quot;</filterFormula>
        <object>Campaign</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
