    <recordCreates>
        <description>Creates all of the Beacon Feedback records built for this Opportunity in one save, in the order they were added to the list. If no record types were found the list is empty and nothing is created.</description>
        <name>Create_Beacon_Feedback_Records</name>
        <label>Create Beacon Feedback Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Fault_Path_Subflow</targetReference>
        </faultConnector>
        <inputReference>colBeaconFeedback</inputReference>
    </recordCreates>
    <recordLookups>
        <description>Retrieves the Beacon Feedback Customer Call record type by its developer name (Customer_Call), so its Id isn&apos;t hardcoded.</description>
        <name>Get_Customer_Call_Record_Type</name>
        <label>Get Customer Call Record Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Was_Customer_Call_Record_Type_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Beacon_Feedback__c</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Customer_Call</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
