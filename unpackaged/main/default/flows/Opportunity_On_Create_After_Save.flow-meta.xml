        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Onboarding_Call_1_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Onboarding_Call_1_Record_Type.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Onboarding_Call_1_Feedback</targetReference>
            </connector>
            <label>Onboarding Call 1 Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks that the Beacon Feedback Sales Demo record type (Sales_Demo) was found. If it was, builds the Sales Demo survey. If not, skips it and moves on to Get Sales Prospecting Record Type, so a missing record type never creates a survey with a blank record type.</description>
        <name>Was_Sales_Demo_Record_Type_Found</name>
