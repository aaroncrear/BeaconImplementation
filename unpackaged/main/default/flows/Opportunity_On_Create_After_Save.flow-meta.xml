    <constants>
        <description>Number of days after the Opportunity Close Date that the Customer Call survey is due.</description>
        <name>conCustomerCallDueDateDays</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>45.0</numberValue>
        </value>
    </constants>
