    </recordCreates>
    <recordDeletes>
        <description>Removes the Sales Demo and Sales Prospecting surveys created while the Opportunity was Subscription New, unless they have been completed (Survey Completed = Yes), so the renewal surveys can replace them.</description>
        <name>Delete_Sales_Surveys</name>
        <label>Delete Sales Surveys</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Onboarding_Call_1_Record_Type</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Path_Subflow</targetReference>
        </faultConnector>
        <filterLogic>1 AND 2 AND (3 OR 4)</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Survey_Completed__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Yes</stringValue>
            </value>
        </filters>
        <filters>
            <field>Survey_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sales Demo</stringValue>
            </value>
        </filters>
        <filters>
            <field>Survey_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sales Prospecting</stringValue>
            </value>
        </filters>
        <object>Beacon_Feedback__c</object>
    </recordDeletes>
