    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Record_Type_Changed_To_Renewal</targetReference>
        </connector>
        <filterFormula>AND(
    {!$Setup.On_Off_Switch__c.Run_Flows__c},
    OR(
        AND(
            ISNEW(),
            OR(
                {!$Record.RecordType.DeveloperName} = &quot;Subscription_New&quot;,
                {!$Record.RecordType.DeveloperName} = &quot;Subscription_Renewal&quot;
            )
        ),
        AND(
            NOT(ISNEW()),
            ISCHANGED({!$Record.RecordTypeId}),
            {!$Record.RecordType.DeveloperName} = &quot;Subscription_Renewal&quot;
        )
    )
)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
