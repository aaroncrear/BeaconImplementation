    <recordCreates>
        <description>Creates all of the Beacon Feedback records built for this Opportunity in one save, in the order they were added to the list.</description>
        <name>Create_Beacon_Feedback_Records</name>
        <label>Create Beacon Feedback Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
