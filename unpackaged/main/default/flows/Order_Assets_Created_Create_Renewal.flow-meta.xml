        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOrderItemIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Order_Items.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSellingModelId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formSellingModelId</elementReference>
            </value>
