    <assignments>
        <description>Stores the fault message so it can be written to the source Opportunity and sent in the fault email.</description>
        <name>Handle_Fault</name>
        <label>Handle Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
