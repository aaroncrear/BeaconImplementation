<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Builds a copy of the current Contact Role for the renewal Opportunity (same Contact, Role and Primary flag) and adds it to the collection to create.</description>
        <name>Add_Renewal_Contact_Role</name>
        <label>Add Renewal Contact Role</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varContactRole.OpportunityId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Renewal_Quote.OpportunityId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varContactRole.ContactId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Source_Contact_Roles.ContactId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varContactRole.Role</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Source_Contact_Roles.Role</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varContactRole.IsPrimary</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Source_Contact_Roles.IsPrimary</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varContactRolesToCreate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varContactRole</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Source_Contact_Roles</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Removes the bundle component Asset from the list of Assets to renew. Create Renewal Quote only accepts top-level Assets and renews their components with them.</description>
        <name>Remove_Bundle_Component</name>
        <label>Remove Bundle Component</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varAssetIds</assignToReference>
            <operator>RemoveAll</operator>
            <value>
                <elementReference>Loop_Bundle_Components.RelatedAssetId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Bundle_Components</targetReference>
        </connector>
    </assignments>
    <assignments>
