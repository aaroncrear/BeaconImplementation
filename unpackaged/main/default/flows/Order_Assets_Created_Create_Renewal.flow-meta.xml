    <recordLookups>
        <description>Gets the Quote&apos;s Opportunity, only if it is a Subscription New Opportunity that the Closed Won automation completed and that has no Renewal Opportunity yet.</description>
        <name>Get_Source_Opportunity</name>
        <label>Get Source Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Source_Opportunity_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Handle_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Quote.OpportunityId</elementReference>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Subscription_New_Record_Type.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Closed_Won_Automation_Complete__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
