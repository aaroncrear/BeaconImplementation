        <connector>
            <targetReference>Loop_Asset_Actions</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Adds the current Asset Action Source&apos;s Asset Action to the list.</description>
        <name>Add_Asset_Action_Id</name>
        <label>Add Asset Action Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varAssetActionIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Asset_Action_Sources.AssetActionId</elementReference>
            </value>
        </assignmentItems>
        <connector>
