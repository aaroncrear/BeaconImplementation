        </connector>
    </assignments>
    <assignments>
        <description>Adds the current Order Product to the list of Order Product Ids and remembers its Product Selling Model (keeping an earlier one if this line has none).</description>
        <name>Add_Order_Item_Id</name>
        <label>Add Order Item Id</label>
