        </connector>
    </assignments>
    <assignments>
        <description>Sets the error message when Create Renewal Quote reports that it didn&apos;t create the renewal quote.</description>
        <name>Set_Renewal_Error</name>
        <label>Set Renewal Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
